{
  "name": "vrc-inventory-manager",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node tools/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/tsconfig.json",
    "lint": "npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"**/*.{css,html,svelte,vue,astro}\" --max-warnings 0",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "dependencies": {
    "gifuct-js": "2.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.7",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "postcss-html": "2.0.0",
    "prettier": "3.10.1",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.0.0",
    "stylelint-high-performance-animation": "2.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
