<Window x:Class="VRCInventoryManager.UpdateWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VRCInventoryManager update"
        AutomationProperties.AutomationId="UpdateWindow"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#17191D"
        Foreground="#F7F5EF">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/AppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock x:Name="HeadingText" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
        <TextBlock x:Name="BodyText" Foreground="{StaticResource SoftTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <ProgressBar x:Name="DownloadBar"
                     Height="6"
                     Margin="0,16,0,0"
                     Minimum="0"
                     Maximum="100"
                     Foreground="{StaticResource AccentBrush}"
                     Background="{StaticResource SurfaceBrush}"
                     BorderThickness="0"
                     Visibility="Collapsed" />
        <TextBlock x:Name="NotesLink" Margin="0,12,0,0">
            <Hyperlink Foreground="{StaticResource AccentBrush}" Click="Notes_Click">
                <Run x:Name="NotesText" />
            </Hyperlink>
        </TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="UpdateButton" Content="Update now" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Update_Click" />
            <Button x:Name="SkipButton" Content="Skip this version" Click="Skip_Click" />
            <Button x:Name="LaterButton" Content="Later" Margin="0" IsCancel="True" Click="Later_Click" />
        </StackPanel>
    </StackPanel>
</Window>
